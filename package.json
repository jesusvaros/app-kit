{
  "name": "@jesusvaros/app-kit",
  "version": "0.4.1",
  "private": true,
  "description": "Login nativo de Google y Apple, notificaciones push y analítica propia para apps Capacitor + Supabase.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/supabase": {
      "types": "./dist/auth/supabase.d.ts",
      "import": "./dist/auth/supabase.js"
    },
    "./push": {
      "types": "./dist/push/index.d.ts",
      "import": "./dist/push/index.js"
    },
    "./push/supabase": {
      "types": "./dist/push/supabase.d.ts",
      "import": "./dist/push/supabase.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "release": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@capacitor/app": ">=7",
    "@capacitor/core": ">=7",
    "@capgo/capacitor-social-login": ">=8.7.5",
    "@supabase/supabase-js": ">=2.40",
    "@capacitor/push-notifications": ">=7"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@capacitor/push-notifications": {
      "optional": true
    },
    "@capgo/capacitor-social-login": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capgo/capacitor-social-login": "8.7.5",
    "@supabase/supabase-js": "2.76.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusvaros/app-kit.git"
  }
}
